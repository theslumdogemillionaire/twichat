PORT=3000
PUBLIC_ORIGIN=https://twichat.theslumdogemillionaire.com
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Where the published packages live. Their names carry the version, so the site reads the current
# one from `latest.yml` in that same folder rather than being told it.
TWICHAT_RELEASE_BASE=https://github.com/theslumdogemillionaire/twichat/releases/latest/download

# Optional, and only if the packages live somewhere else: an explicit address per platform, which
# wins over the base above. Names: MAC, WINDOWS, APPIMAGE, APPIMAGE_ARM64, DEB, RPM, DEB_ARM64,
# RPM_ARM64.
# TWICHAT_DOWNLOAD_MAC_URL=

# The proxies whose X-Forwarded-For may be believed, by the address they connect from.
# Empty — the default — counts the socket address and ignores the header: an unproxied server
# must never take a client's word for its own address, or the rate limit stops nobody.
# Behind one proxy, name it here and the address it appended is the one counted.
TWICHAT_TRUSTED_PROXIES=

# How many sign-ins may be in flight at once. A full table turns newcomers away rather than
# evicting someone else's sign-in. Defaults to 2000.
TWICHAT_MAX_SESSIONS=
